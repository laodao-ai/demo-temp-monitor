+++ b/internal/httpapi/e2e_integration_test.go
@@ -0,0 +1,129 @@
+//go:build integration
+
+package httpapi_test
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/laodao-ai/demo-temp-monitor/internal/httpapi"
+	"github.com/laodao-ai/demo-temp-monitor/internal/redact"
+	"github.com/laodao-ai/demo-temp-monitor/internal/service"
+	"github.com/laodao-ai/demo-temp-monitor/internal/store/pgstore"
+	"github.com/laodao-ai/demo-temp-monitor/internal/testdb"
+)
+
+// TestIntegrationEndToEnd runs TST-08 over HTTP handler + service + PostgreSQL:
+// register, report above the threshold, find the reading, see the alarm in the
+// log, deregister, find no readings.
+func TestIntegrationEndToEnd(t *testing.T) {
+	pool := testdb.Open(t)
+	st := pgstore.New(pool)
+
+	// The log buffer goes through the redacting handler, like the real service.
+	var logBuf bytes.Buffer
+	logger := slog.New(redact.Handler(slog.NewTextHandler(&logBuf, nil), pool.Config().ConnString()))
+	const thresholdC = 50.0
+	srv := httptest.NewServer(httpapi.NewHandler(service.New(st, thresholdC, logger), logger))
+	t.Cleanup(srv.Close)
+
+	id := newTestID(t)
+	t.Cleanup(func() {
+		// Safety net in case a step failed before the deregister step.
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		_, _ = pool.Exec(ctx, `DELETE FROM devices WHERE id = $1`, id)
+	})
+
+	// 1. Register.
+	resp := send(t, srv, http.MethodPost, "/devices", `{"id":"`+id+`"}`)
+	if resp.StatusCode != http.StatusCreated {
+		t.Fatalf("register status = %d, want 201", resp.StatusCode)
+	}
+
+	// 2. Report a reading above the threshold.
+	resp = send(t, srv, http.MethodPost, "/devices/"+id+"/readings", `{"temperature_c":55.0}`)
+	if resp.StatusCode != http.StatusCreated {
+		t.Fatalf("report status = %d, want 201", resp.StatusCode)
+	}
+	var reported struct {
+		ID           int64   `json:"id"`
+		DeviceID     string  `json:"device_id"`
+		TemperatureC float64 `json:"temperature_c"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&reported); err != nil {
+		t.Fatal(err)
+	}
+
+	// 3. The reading is in the database.
+	readings, err := st.ListReadings(t.Context(), id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(readings) != 1 || readings[0].ID != reported.ID || readings[0].TemperatureC != 55.0 {
+		t.Fatalf("stored readings = %+v, reported = %+v", readings, reported)
+	}
+
+	// 4. The log has one alarm for this device.
+	if got := alarmLines(logBuf.String(), id); len(got) != 1 {
+		t.Fatalf("alarm lines for %s = %d, want 1\nlog:\n%s", id, len(got), logBuf.String())
+	}
+
+	// 5. Deregister: the device's readings are gone.
+	resp = send(t, srv, http.MethodDelete, "/devices/"+id, "")
+	if resp.StatusCode != http.StatusNoContent {
+		t.Fatalf("deregister status = %d, want 204", resp.StatusCode)
+	}
+	readings, err = st.ListReadings(t.Context(), id)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(readings) != 0 {
+		t.Fatalf("readings after deregister = %d, want 0", len(readings))
+	}
+}
+
+func newTestID(t *testing.T) string {
+	t.Helper()
+	var b [6]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		t.Fatal(err)
+	}
+	return "it-" + hex.EncodeToString(b[:])
+}
+
+func send(t *testing.T, srv *httptest.Server, method, path, body string) *http.Response {
+	t.Helper()
+	req, err := http.NewRequestWithContext(t.Context(), method, srv.URL+path, strings.NewReader(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	resp, err := srv.Client().Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { resp.Body.Close() })
+	return resp
+}
+
+// alarmLines returns the WARN alarm lines that mention this device.
+func alarmLines(log, deviceID string) []string {
+	var out []string
+	for _, line := range strings.Split(log, "\n") {
+		if strings.Contains(line, "level=WARN") &&
+			strings.Contains(line, `msg="over-temperature alarm"`) &&
+			strings.Contains(line, "device_id="+deviceID) {
+			out = append(out, line)
+		}
+	}
+	return out
+}
diff --git a/internal/store/pgstore/pgstore.go b/internal/store/pgstore/pgstore.go
new file mode 100644
index 0000000..2aa8777
--- /dev/null
+++ b/internal/store/pgstore/pgstore.go
@@ -0,0 +1,146 @@
+// Package pgstore is the PostgreSQL implementation of store.Store.
+// It never checks before writing: the database constraints decide, and
+// SQLSTATE 23505 / 23503 are mapped to the store sentinel errors.
+package pgstore
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+	"github.com/jackc/pgx/v5/pgxpool"
+	"github.com/laodao-ai/demo-temp-monitor/internal/store"
+)
+
+const (
+	// ConnectTimeout bounds connecting, the first ping, and the schema check.
+	ConnectTimeout = 5 * time.Second
+	// maxConns keeps every client pool small: the PgBouncer session pool gives
+	// each client connection a dedicated backend and has a fixed total limit.
+	maxConns = 4
+
+	sqlStateUniqueViolation     = "23505"
+	sqlStateForeignKeyViolation = "23503"
+)
+
+var (
+	// ErrConnect means the pool could not be built or the database did not
+	// answer a ping. It carries no driver text on purpose: the driver can echo
+	// parts of a malformed password as a host name.
+	ErrConnect = errors.New("cannot connect to database")
+	// ErrSchemaMissing means devices or readings does not exist.
+	ErrSchemaMissing = errors.New("table devices or readings not found")
+)
+
+// Connect builds a pool with MaxConns=4 and pings it within ConnectTimeout.
+func Connect(ctx context.Context, connURL string) (*pgxpool.Pool, error) {
+	cfg, err := pgxpool.ParseConfig(connURL)
+	if err != nil {
+		return nil, ErrConnect
+	}
+	cfg.MaxConns = maxConns
+
+	ctx, cancel := context.WithTimeout(ctx, ConnectTimeout)
+	defer cancel()
+	pool, err := pgxpool.NewWithConfig(ctx, cfg)
+	if err != nil {
+		return nil, ErrConnect
+	}
+	if err := pool.Ping(ctx); err != nil {
+		pool.Close()
+		return nil, ErrConnect
+	}
+	return pool, nil
+}
+
+// CheckSchema returns ErrSchemaMissing unless both tables exist.
+// Any other error comes from the driver and must be redacted before output.
+func CheckSchema(ctx context.Context, pool *pgxpool.Pool) error {
+	ctx, cancel := context.WithTimeout(ctx, ConnectTimeout)
+	defer cancel()
+	var ok bool
+	err := pool.QueryRow(ctx,
+		`SELECT to_regclass('devices') IS NOT NULL AND to_regclass('readings') IS NOT NULL`,
+	).Scan(&ok)
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return ErrSchemaMissing
+	}
+	return nil
+}
+
+// Store implements store.Store on a pgx pool.
+type Store struct {
+	pool *pgxpool.Pool
+}
+
+func New(pool *pgxpool.Pool) *Store {
+	return &Store{pool: pool}
+}
+
+func (s *Store) CreateDevice(ctx context.Context, id string) (store.Device, error) {
+	var d store.Device
+	err := s.pool.QueryRow(ctx,
+		`INSERT INTO devices (id) VALUES ($1) RETURNING id, registered_at`, id,
+	).Scan(&d.ID, &d.RegisteredAt)
+	if err != nil {
+		return store.Device{}, mapErr(err, sqlStateUniqueViolation, store.ErrAlreadyExists)
+	}
+	return d, nil
+}
+
+func (s *Store) DeleteDevice(ctx context.Context, id string) error {
+	tag, err := s.pool.Exec(ctx, `DELETE FROM devices WHERE id = $1`, id)
+	if err != nil {
+		return err
+	}
+	if tag.RowsAffected() == 0 {
+		return store.ErrNotFound
+	}
+	return nil
+}
+
+func (s *Store) AddReading(ctx context.Context, deviceID string, tempC float64) (store.Reading, error) {
+	var r store.Reading
+	err := s.pool.QueryRow(ctx,
+		`INSERT INTO readings (device_id, temperature_c) VALUES ($1, $2)
+		 RETURNING id, device_id, temperature_c, recorded_at`, deviceID, tempC,
+	).Scan(&r.ID, &r.DeviceID, &r.TemperatureC, &r.RecordedAt)
+	if err != nil {
+		return store.Reading{}, mapErr(err, sqlStateForeignKeyViolation, store.ErrNotFound)
+	}
+	return r, nil
+}
+
+func (s *Store) ListReadings(ctx context.Context, deviceID string) ([]store.Reading, error) {
+	rows, err := s.pool.Query(ctx,
+		`SELECT id, device_id, temperature_c, recorded_at
+		 FROM readings WHERE device_id = $1 ORDER BY id`, deviceID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	out, err := pgx.CollectRows(rows, func(row pgx.CollectableRow) (store.Reading, error) {
+		var r store.Reading
+		err := row.Scan(&r.ID, &r.DeviceID, &r.TemperatureC, &r.RecordedAt)
+		return r, err
+	})
+	if err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+// mapErr returns sentinel when err is a PostgreSQL error with the given
+// SQLSTATE, and err unchanged otherwise.
+func mapErr(err error, sqlState string, sentinel error) error {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == sqlState {
+		return sentinel
+	}
+	return err
+}
