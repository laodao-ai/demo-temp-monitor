# Copy this file to config/local.env and fill it in. config/local.env is gitignored.
# One KEY=VALUE per line. No quotes, no variable expansion, no inline comments.

# pgx connection string.
# Connect to the SESSION pool port (7432 here), not the transaction pool (6432):
# the service uses prepared statements, which a transaction pool breaks.
# URL-encode special characters in the password (for example @ -> %40, # -> %23).
TM_DATABASE_URL=postgres://temp_monitor_demo:CHANGE_ME@127.0.0.1:7432/temp_monitor_demo?sslmode=disable

# Listen address. Keep it on 127.0.0.1: the service has no authentication.
TM_LISTEN_ADDR=127.0.0.1:8080

# Alarm threshold in degrees Celsius. A reading strictly above it raises an alarm.
TM_ALARM_THRESHOLD_C=50.0
